---
componentName: bigcommunity

# The main installer window remains native. QML provides the shell and the
# supported view modules; partitioning keeps the official Qt Widgets module.
welcomeStyleCalamares: false
welcomeExpandingLogo: false

windowExpanding: normal
windowSize: 1024px,680px
windowPlacement: center

sidebar: qml,left
navigation: qml,bottom

strings:
    productName: BigCommunity
    shortProductName: BigCommunity
    version: "${BUILD_ID}"
    shortVersion: "${BUILD_ID}"
    versionedName: "${PRETTY_NAME}"
    shortVersionedName: "BigCommunity ${BUILD_ID}"
    bootloaderEntryName: BigCommunity
    productUrl: https://communitybig.org
    # The forum is shared with BigLinux on purpose.
    supportUrl: https://forum.biglinux.com.br
    knownIssuesUrl: https://github.com/communitybig
    releaseNotesUrl: https://communitybig.org
    donateUrl: ""

images:
    productLogo: "logo.svg"
    productIcon: "/usr/share/icons/hicolor/scalable/apps/icon-big-hd-install.svg"
    # Static fallback used only if the traditional welcome module is restored.
    productWelcome: "welcome-illustration.svg"

slideshow: "BigBlocks.qml"
slideshowAPI: 2

style:
    SidebarBackground: "#1E2936"
    SidebarText: "#F8FAFC"
    SidebarBackgroundCurrent: "#0E7490"
    SidebarTextCurrent: "#FFFFFF"
