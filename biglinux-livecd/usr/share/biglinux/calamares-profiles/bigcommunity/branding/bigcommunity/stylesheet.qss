/*
 * Keep QWidget overrides semantic and palette-neutral. The sidebar and the
 * installation game are QML components and are styled in their own files.
 */

#mainApp #WelcomePage #mainText {
    font-size: 20px;
    font-weight: 600;
}

#mainApp #WelcomePage #subText {
    font-size: 13px;
}

#mainApp #WelcomePage QComboBox {
    min-height: 34px;
    padding: 4px 10px;
}

#mainApp QPushButton {
    min-height: 34px;
    padding: 7px 18px;
}
