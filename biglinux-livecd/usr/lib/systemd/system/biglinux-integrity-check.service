[Unit]
Description=Verify BigLinux live media in the background
Documentation=https://github.com/biglinux/biglinux-livecd
ConditionPathExists=/livefs-pkgs.txt
# Starts with the display manager, so the check runs while the user is still
# picking a language instead of only when the installer is opened, which left
# the wait dialog on screen for minutes. It is not ordered after
# graphical.target: that waits for multi-user.target and so for every unit
# behind network-online.target, which held the check back for the whole
# wait-online timeout. Nothing is ordered before it and every scheduler knob
# below is the lowest one available, so it only consumes the CPU and the media
# bandwidth the boot is not using.
After=local-fs.target display-manager.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/biglinux-verify-md5sum --no-gui
TimeoutStartSec=infinity
RemainAfterExit=true
Nice=19
CPUSchedulingPolicy=idle
CPUWeight=1
IOSchedulingClass=idle
IOSchedulingPriority=7
IOWeight=1
UMask=0077
PrivateDevices=true
PrivateMounts=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/biglinux-live/integrity
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=graphical.target
