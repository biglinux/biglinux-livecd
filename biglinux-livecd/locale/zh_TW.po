#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:52
msgid ""
"If you opt for automatic partitioning, these tips will be applied by "
"default."
msgstr "如果選擇自動分割磁碟，預設會套用這些建議。"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:59
msgid "Use BTRFS"
msgstr "使用 BTRFS"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:61
msgid "This file system allows for automatic compression and restore points."
msgstr "這個檔案系統支援自動壓縮與建立還原點。"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:65
msgid "Keep /boot within the / partition"
msgstr "將 /boot 保留在 / 分割區內"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:67
msgid "Placing it in a separate partition hampers BTRFS snapshots."
msgstr "將 /boot 放在獨立分割區會影響 BTRFS 快照的使用。"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:71
msgid "Do not create a SWAP partition"
msgstr "不要建立 SWAP 分割區"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:73
msgid ""
"We have implemented dynamic virtual memory management with Zram and SWAP "
"files. SWAP partitions will not be used."
msgstr "我們已透過 Zram 與 SWAP 檔案實作動態虛擬記憶體管理。系統不會使用 SWAP 分割區。"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:103
msgid "Installation tips: read the recommendations before proceeding"
msgstr "安裝提示：繼續之前請先閱讀建議"

