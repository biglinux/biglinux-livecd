#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:513
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:515
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:563
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:565
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:673
msgid "Close"
msgstr "Закрыць"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:482
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:520
msgid "Error"
msgstr "Памылка"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:532
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:571
msgid "Information"
msgstr "Інфармацыя"

