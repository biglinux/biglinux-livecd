msgid "BigLinux Setup"
msgstr "Наладжванне BigLinux"

msgid "press Super+Alt+S to start the screen reader"
msgstr "націсніце Super+Alt+S, каб запусціць праграму чытання з экрана"

msgid "BigLinux Logo"
msgstr "Лагатып BigLinux"

msgid "Language"
msgstr "Мова"

msgid "Keyboard"
msgstr "Клавіятура"

msgid "Desktop Layout"
msgstr "Макет працоўнага стала"

msgid "Theme"
msgstr "Тэма"

msgid "Accessibility enabled. Use arrow keys to navigate."
msgstr ""
"Спецыяльныя магчымасці ўключаны. Для навігацыі выкарыстоўвайце клавішы са "
"стрэлкамі."

msgid "Settings"
msgstr "Налады"

msgid "JamesDSP Audio"
msgstr "Аўдыя JamesDSP"

msgid "Enable audio improvements"
msgstr "Уключыць паляпшэнні гуку"

msgid "Image quality"
msgstr "Якасць выявы"

msgid "Enable enhanced contrast"
msgstr "Уключыць палепшаны кантраст"

msgid "press Enter or Space to toggle"
msgstr "націсніце Enter або прабел, каб пераключыць"

msgid "enabled"
msgstr "уключана"

msgid "disabled"
msgstr "адключана"

msgid "Choose a Theme Style"
msgstr "Выберыце стыль тэмы"

msgid "Choose a System Theme"
msgstr "Выберыце сістэмную тэму"

msgid "Dark Theme"
msgstr "Цёмная тэма"

msgid "Light Theme"
msgstr "Светлая тэма"

msgid "Search for a language..."
msgstr "Пошук мовы..."

msgid "Could not load language data."
msgstr "Не ўдалося загрузіць даныя мовы."

