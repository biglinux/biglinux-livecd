msgstr "Vinsamlegast bíddu..."

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:42
msgid "Checking the integrity of the download and storage device..."
msgstr "Verið er að athuga heilleika niðurhalsins og geymslutækisins..."

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:43
msgid "Checking system integrity"
msgstr "Verið er að athuga heilleika kerfisins"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:44
msgid ""
"Checking for download or USB drive errors, this may take a few minutes..."
msgstr ""
"Leitað er að villum í niðurhali eða á USB-drifi. Þetta getur tekið nokkrar "
"mínútur..."

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:45
msgid "Verification progress"
msgstr "Framvinda sannprófunar"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:46
#, python-brace-format
msgid "Checking the file: {filename}"
msgstr "Verið er að athuga skrána: {filename}"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:47
msgid "Verification failed"
msgstr "Sannprófun mistókst"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:49
msgid ""
"The live media could not be verified. Download the system again or use "
"another USB drive."
msgstr ""
"Ekki tókst að sannprófa live-miðilinn. Sæktu kerfið aftur eða notaðu annað "
"USB-drif."

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:52
msgid "Verification complete"
msgstr "Sannprófun lokið"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:53
msgid "The files are intact."
msgstr "Skrárnar eru óskemmdar."

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:54
msgid "Verification canceled"
msgstr "Hætt við sannprófun"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:55
msgid "The integrity check was not completed."
msgstr "Heilleikaathuguninni var ekki lokið."

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:110
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:135
