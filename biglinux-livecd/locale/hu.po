msgid "Install the system"
msgstr "A rendszer telepítése"

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:340
msgid "Installation log unavailable"
msgstr "A telepítési napló nem érhető el"

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:236
msgid "Could not inspect EFI partitions"
msgstr "Az EFI partíciók nem vizsgálhatók meg"

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:341
msgid ""
"Calamares did not create a valid installation log. Close the installer and "
"try again."
msgstr ""
"A Calamares nem hozott létre érvényes telepítési naplót. Zárja be a "
"telepítőt, és próbálja újra."

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:237
msgid ""
"The installer could not safely inspect the disk layout. Close the installer,"
" reconnect the storage device, and try again."
msgstr ""
"A telepítő nem tudta biztonságosan megvizsgálni a lemez felosztását. Zárja "
"be a telepítőt, csatlakoztassa újra a tárolóeszközt, és próbálja újra."

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:245
msgid ""
"Do you want to proceed with the installation in EFI mode? The current boot "
"is using EFI mode, but I did not find an EFI partition on this computer."
msgstr ""
"Folytatja a telepítést EFI módban? A jelenlegi indítás EFI módot használ, de"
" nem találtam EFI partíciót ezen a számítógépen."

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:253
msgid ""
"Do you want to proceed with the installation in Legacy/BIOS mode? I found an"
" EFI partition on this computer."
msgstr ""
"Folytatja a telepítést Legacy/BIOS módban? Találtam egy EFI partíciót ezen a"
" számítógépen."

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:112
msgid ""
"Do you want to proceed with the installation of this old version anyway? "
"BigLinux is a system with weekly updates and this version was released more "
"than a month ago. We recommend downloading a more recent version."
msgstr ""
"Mindenképp folytatja ennek a régi verziónak a telepítését? A BigLinux "
"hetente frissül, és ez a verzió több mint egy hónapja jelent meg. Javasoljuk"
" egy újabb verzió letöltését."

