#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/main_page.py:259
#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/main_page.py:270
#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/main_page.py:274
#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/main_page.py:290
msgid "Install"
msgstr "Встановити"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/main_page.py:226
msgid "Minimal"
msgstr "Мінімальна"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/main_page.py:228
msgid "Remove pre-selected software to create a lean, personalized system."
msgstr ""
"Видаліть попередньо вибране програмне забезпечення, щоб створити легку "
"персоналізовану систему."

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/main_page.py:262
msgid "Configuring..."
msgstr "Налаштування..."

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/main_page.py:291
msgid "Main page: choose Maintenance, Installation, or Minimal"
msgstr ""
"Головна сторінка: виберіть «Обслуговування», «Встановлення» або «Мінімальна»"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:40
#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:42
msgid "Important Tips"
msgstr "Важливі поради"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:50
msgid "Manual Partitioning Recommendations"
msgstr "Рекомендації щодо ручної розмітки диска"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:52
msgid ""
"If you opt for automatic partitioning, these tips will be applied by "
"default."
msgstr ""
"Якщо ви виберете автоматичне розбиття диска, ці рекомендації буде "
"застосовано за замовчуванням."

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:59
msgid "Use BTRFS"
msgstr "Використовуйте BTRFS"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:61
msgid "This file system allows for automatic compression and restore points."
msgstr ""
"Ця файлова система підтримує автоматичне стиснення та створення точок "
"відновлення."

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:65
msgid "Keep /boot within the / partition"
msgstr "Залиште /boot у розділі /"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:67
msgid "Placing it in a separate partition hampers BTRFS snapshots."
msgstr ""
"Розміщення /boot в окремому розділі ускладнює використання знімків BTRFS."

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:71
msgid "Do not create a SWAP partition"
msgstr "Не створюйте розділ SWAP"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:73
msgid ""
"We have implemented dynamic virtual memory management with Zram and SWAP "
"files. SWAP partitions will not be used."
msgstr ""
"Ми реалізували динамічне керування віртуальною пам’яттю за допомогою Zram і "
"файлів SWAP. Розділи SWAP не використовуватимуться."

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:103
msgid "Installation tips: read the recommendations before proceeding"
msgstr ""
"Поради зі встановлення: ознайомтеся з рекомендаціями перед продовженням"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:41
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:263
