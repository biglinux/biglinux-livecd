#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/main_page.py:291
msgid "Main page: choose Maintenance, Installation, or Minimal"
msgstr "Strona główna: wybierz Konserwację, Instalację lub Minimalną"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:40
#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:42
msgid "Important Tips"
msgstr "Ważne wskazówki"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:50
msgid "Manual Partitioning Recommendations"
msgstr "Zalecenia dotyczące ręcznego partycjonowania"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:52
msgid ""
"If you opt for automatic partitioning, these tips will be applied by "
"default."
msgstr ""
"Jeśli wybierzesz automatyczne partycjonowanie, te zalecenia zostaną "
"zastosowane domyślnie."

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:59
msgid "Use BTRFS"
msgstr "Użyj BTRFS"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:61
msgid "This file system allows for automatic compression and restore points."
msgstr ""
"Ten system plików umożliwia automatyczną kompresję i tworzenie punktów "
"przywracania."

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:65
msgid "Keep /boot within the / partition"
msgstr "Zachowaj /boot w partycji /"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:67
msgid "Placing it in a separate partition hampers BTRFS snapshots."
msgstr ""
"Umieszczenie /boot na osobnej partycji utrudnia korzystanie z migawek BTRFS."

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:71
msgid "Do not create a SWAP partition"
msgstr "Nie twórz partycji SWAP"

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:73
msgid ""
"We have implemented dynamic virtual memory management with Zram and SWAP "
"files. SWAP partitions will not be used."
msgstr ""
"Wdrożyliśmy dynamiczne zarządzanie pamięcią wirtualną przy użyciu Zram i "
"plików SWAP. Partycje SWAP nie będą używane."

#: biglinux-livecd/usr/share/biglinux/calamares/src/pages/tips_page.py:103
msgid "Installation tips: read the recommendations before proceeding"
msgstr ""
"Wskazówki dotyczące instalacji: przed kontynuowaniem przeczytaj zalecenia"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:41
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:263
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:295
msgid "Please wait..."
msgstr "Proszę czekać..."

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:42
msgid "Checking the integrity of the download and storage device..."
msgstr ""
"Sprawdzanie integralności pobranych danych i urządzenia pamięci masowej..."

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:43
msgid "Checking system integrity"
msgstr "Sprawdzanie integralności systemu"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:44
msgid ""
"Checking for download or USB drive errors, this may take a few minutes..."
msgstr ""
"Sprawdzanie błędów pobierania lub pamięci USB. Może to potrwać kilka "
"minut..."

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:45
msgid "Verification progress"
msgstr "Postęp weryfikacji"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:46
#, python-brace-format
msgid "Checking the file: {filename}"
msgstr "Sprawdzanie pliku: {filename}"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:47
msgid "Verification failed"
msgstr "Weryfikacja nie powiodła się"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:49
msgid ""
"The live media could not be verified. Download the system again or use "
"another USB drive."
msgstr ""
"Nie udało się zweryfikować nośnika live. Pobierz system ponownie lub użyj "
"innej pamięci USB."

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:52
msgid "Verification complete"
msgstr "Weryfikacja zakończona"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:53
msgid "The files are intact."
msgstr "Pliki są nienaruszone."

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:54
msgid "Verification canceled"
msgstr "Weryfikacja anulowana"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:55
msgid "The integrity check was not completed."
msgstr "Kontrola integralności nie została zakończona."

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:110
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:135
msgid "Progress"
msgstr "Postęp"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:407
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:470
msgid "Question"
msgstr "Pytanie"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:442
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:513
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:515
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:563
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:565
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:673
msgid "Close"
msgstr "Zamknij"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:482
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:520
msgid "Error"
msgstr "Błąd"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:532
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:571
msgid "Information"
msgstr "Informacje"

#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:594
#: biglinux-livecd/usr/share/biglinux/calamares/gtk_dialog.py:695
msgid "Select"
msgstr "Wybierz"

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:362
msgid "Installation failed"
msgstr "Instalacja nie powiodła się"

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:363
msgid ""
"The installation failed. The local error log was saved in your home folder."
msgstr ""
"Instalacja nie powiodła się. Lokalny dziennik błędów został zapisany w "
"katalogu domowym."

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:111
msgid "Outdated Version"
msgstr "Nieaktualna wersja"

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:244
#: biglinux-livecd/usr/bin/calamares-biglinux:252
msgid "Install the system"
msgstr "Zainstaluj system"

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:340
msgid "Installation log unavailable"
msgstr "Dziennik instalacji niedostępny"

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:236
msgid "Could not inspect EFI partitions"
msgstr "Nie udało się sprawdzić partycji EFI"

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:341
msgid ""
"Calamares did not create a valid installation log. Close the installer and "
"try again."
msgstr ""
"Calamares nie utworzył prawidłowego dziennika instalacji. Zamknij instalator"
" i spróbuj ponownie."

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:237
msgid ""
"The installer could not safely inspect the disk layout. Close the installer,"
" reconnect the storage device, and try again."
msgstr ""
"Instalator nie mógł bezpiecznie sprawdzić układu dysku. Zamknij instalator, "
"podłącz ponownie urządzenie pamięci masowej i spróbuj ponownie."

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:245
msgid ""
"Do you want to proceed with the installation in EFI mode? The current boot "
"is using EFI mode, but I did not find an EFI partition on this computer."
msgstr ""
"Czy chcesz kontynuować instalację w trybie EFI? Bieżące uruchomienie używa "
"trybu EFI, ale nie znalazłem partycji EFI na tym komputerze."

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:253
msgid ""
"Do you want to proceed with the installation in Legacy/BIOS mode? I found an"
" EFI partition on this computer."
msgstr ""
"Czy chcesz kontynuować instalację w trybie Legacy/BIOS? Znalazłem partycję "
"EFI na tym komputerze."

# Installer launcher, usr/bin/calamares-biglinux
#: biglinux-livecd/usr/bin/calamares-biglinux:112
msgid ""
"Do you want to proceed with the installation of this old version anyway? "
"BigLinux is a system with weekly updates and this version was released more "
"than a month ago. We recommend downloading a more recent version."
msgstr ""
"Czy mimo to chcesz kontynuować instalację tej starej wersji? BigLinux jest "
"aktualizowany co tydzień, a ta wersja została wydana ponad miesiąc temu. "
"Zalecamy pobranie nowszej wersji."

#: biglinux-livecd/usr/share/biglinux/calamares-profiles/xivastudio/branding/xivastudio/pong.qml:269
msgid "Pause"
msgstr "Wstrzymaj"
